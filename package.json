{
  "name": "opencode-island",
  "version": "0.1.0",
  "description": "A macOS Dynamic Island for OpenCode: live status of every session and agent on your machine, plus permission prompts you can answer without leaving your work.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "dynamic-island",
    "macos",
    "electron",
    "monitoring"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soussihamza/opencode-island.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build --config vite.island.config.ts && vite build",
    "dev": "vite build --config vite.island.config.ts && vite build --watch",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p src/island/app --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.7",
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "^1.9.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plugin-solid": "^2.11.0"
  }
}
